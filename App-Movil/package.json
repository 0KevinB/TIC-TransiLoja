{
  "name": "TransiLoja",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "start:clean": "expo start --clear",
    "android": "expo run:android",
    "android:clean": "cd android && ./gradlew clean && cd .. && npx expo prebuild --clean && npx expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --coverageReporters=html --coverageReporters=text",
    "test:unit": "jest __tests__/components __tests__/hooks __tests__/lib __tests__/utils",
    "test:integration": "jest __tests__/integration",
    "test:performance": "jest __tests__/performance",
    "test:a11y": "jest __tests__/accessibility",
    "test:e2e": "maestro test e2e/ --format junit --output Resultados/Maestro/flows",
    "test:e2e:offline": "maestro test e2e/offline.yaml --format junit --output Resultados/Maestro/flows",
    "test:e2e:gps": "maestro test e2e/conductor_gps_sharing.yaml --format junit --output Resultados/Maestro/flows",
    "test:e2e:trip": "maestro test e2e/trip_creation.yaml --format junit --output Resultados/Maestro/flows",
    "test:e2e:tracking": "maestro test e2e/bus_tracking.yaml --format junit --output Resultados/Maestro/flows",
    "test:e2e:perf": "maestro test e2e/performance.yaml --format junit --output Resultados/Maestro/flows",
    "test:e2e:a11y": "maestro test e2e/accessibility-modes.yaml --format junit --output Resultados/Maestro/flows",
    "test:e2e:a11y-nav": "maestro test e2e/accessibility-navigation.yaml --format junit --output Resultados/Maestro/flows",
    "test:e2e:expo": "powershell -ExecutionPolicy Bypass -File scripts/test-expo-go.ps1",
    "test:e2e:apk": "bash scripts/test-apk.sh",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:performance && npm run test:a11y",
    "test:full": "npm run test:coverage && npm run test:report",
    "check-notifications": "node ./scripts/check-notifications-setup.js",
    "check-firebase": "node ./scripts/check-firebase-setup.js",
    "prebuild": "npx expo prebuild",
    "prebuild:clean": "npx expo prebuild --clean"
  },
  "dependencies": {
    "@babel/runtime": "^7.28.4",
    "@expo/server": "^0.7.5",
    "@expo/vector-icons": "^14.1.0",
    "@react-native-async-storage/async-storage": "^1.24.0",
    "@react-native-community/netinfo": "11.4.1",
    "@react-native-firebase/app": "^23.7.0",
    "@react-native-firebase/crashlytics": "^23.7.0",
    "@react-native-firebase/perf": "^23.7.0",
    "@react-native-picker/picker": "2.11.1",
    "@react-native/assets-registry": "^0.83.0",
    "@react-native/js-polyfills": "^0.83.0",
    "@react-navigation/bottom-tabs": "^7.3.10",
    "@react-navigation/elements": "^2.3.8",
    "@react-navigation/native": "^7.1.6",
    "expo": "~53.0.23",
    "expo-blur": "~14.1.5",
    "expo-constants": "~17.1.7",
    "expo-device": "^8.0.9",
    "expo-font": "~13.3.2",
    "expo-haptics": "~14.1.4",
    "expo-image": "~2.4.1",
    "expo-linear-gradient": "^14.1.5",
    "expo-linking": "~7.1.7",
    "expo-location": "~18.1.6",
    "expo-notifications": "^0.31.4",
    "expo-router": "~5.1.7",
    "expo-splash-screen": "~0.30.10",
    "expo-status-bar": "~2.2.3",
    "expo-symbols": "~0.4.5",
    "expo-system-ui": "~5.0.11",
    "expo-web-browser": "~14.2.0",
    "firebase": "^12.1.0",
    "nativewind": "^4.1.23",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.5",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-google-places-autocomplete": "^2.5.7",
    "react-native-maps": "1.20.1",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-svg": "15.11.2",
    "react-native-web": "~0.20.0",
    "react-native-webview": "^13.13.5",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.11",
    "@types/react": "~19.0.10",
    "@types/react-native": "^0.72.8",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~9.2.0",
    "jest": "^29.7.0",
    "jest-expo": "^53.0.0",
    "jest-html-reporter": "^4.3.0",
    "jest-junit": "^16.0.0",
    "typescript": "~5.8.3"
  },
  "overrides": {
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-test-renderer": "19.0.0"
  },
  "private": true
}
